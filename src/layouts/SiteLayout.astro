---
import '../styles.css';
import profile from '../data/profile.json';

interface Props {
  title: string;
  activePage: string;
  background: string;
}

const { title, activePage, background } = Astro.props;

const navigation = [
  { label: 'home', href: '/' },
  { label: 'about', href: '/about' },
  { label: 'projects', href: '/projects' },
  { label: 'skills', href: '/skills' },
  { label: 'achievements', href: '/achievements' },
  { label: 'contact', href: '/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {profile.displayName} Portfolio</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,400;1,600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="page-bg" style={`background-image: url('${background}');`}>
    <aside class="sidebar">
      <div class="logo-container">
        <button
          class="logo owner-login-trigger cursor-pointer select-none"
          type="button"
          aria-label="Open owner access"
          aria-haspopup="dialog"
          aria-controls="owner-login-dialog"
        >
          {profile.brand}
        </button>
        <span class="logo-sub">portfolio</span>
        <div class="logo-tagline">{profile.tagline}</div>
      </div>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="nav-menu" id="site-navigation">
        {navigation.map(({ label, href }) => (
          <a href={href} class:list={['nav-item', { active: activePage === label }]}>{label}</a>
        ))}
      </nav>
      <div class="sidebar-footer">
        <span>{profile.academicLabel}</span>
      </div>
    </aside>

    <dialog class="owner-login-dialog" id="owner-login-dialog" aria-labelledby="owner-login-title" aria-describedby="owner-login-description">
      <div class="owner-login-card">
        <button class="owner-login-close" type="button" aria-label="Close owner access">
          &times;
        </button>
        <span class="owner-login-label">Owner Access</span>
        <h2 id="owner-login-title">kei. admin workspace</h2>
        <p id="owner-login-description">
          Sign in with your authorized GitHub account to manage projects, skills, achievements, and profile details.
        </p>
        <a class="owner-login-continue" href="/admin/">
          Continue to Owner Editor
        </a>
        <button class="owner-login-cancel" type="button">Cancel</button>
      </div>
    </dialog>

    <main class="content-container">
      <slot />
    </main>
    <slot name="scripts" />
    <script>
      const page = document.body;
      let pointerFrame = 0;

      page.addEventListener('pointermove', (event) => {
        if (pointerFrame) {
          cancelAnimationFrame(pointerFrame);
        }

        pointerFrame = requestAnimationFrame(() => {
          page.style.setProperty('--mouse-x', `${event.clientX}px`);
          page.style.setProperty('--mouse-y', `${event.clientY}px`);
          pointerFrame = 0;
        });
      });

      const sidebar = document.querySelector('.sidebar');
      const menuToggle = document.querySelector('.menu-toggle');
      const ownerLoginTrigger = document.querySelector('.owner-login-trigger');
      const ownerLoginDialog = document.querySelector('.owner-login-dialog');
      const ownerLoginClose = document.querySelector('.owner-login-close');
      const ownerLoginCancel = document.querySelector('.owner-login-cancel');

      if (
        ownerLoginTrigger instanceof HTMLButtonElement &&
        ownerLoginDialog instanceof HTMLDialogElement &&
        ownerLoginClose instanceof HTMLButtonElement &&
        ownerLoginCancel instanceof HTMLButtonElement
      ) {
        ownerLoginTrigger.addEventListener('click', () => ownerLoginDialog.showModal());
        ownerLoginClose.addEventListener('click', () => ownerLoginDialog.close());
        ownerLoginCancel.addEventListener('click', () => ownerLoginDialog.close());
        ownerLoginDialog.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            ownerLoginDialog.close();
          }
        });
        ownerLoginDialog.addEventListener('click', (event) => {
          if (event.target === ownerLoginDialog) {
            ownerLoginDialog.close();
          }
        });
      }

      if (sidebar instanceof HTMLElement && menuToggle instanceof HTMLButtonElement) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          menuToggle.setAttribute(
            'aria-label',
            isExpanded ? 'Open navigation menu' : 'Close navigation menu',
          );
          sidebar.classList.toggle('is-open', !isExpanded);
        });

        sidebar.querySelectorAll('.nav-item').forEach((item) => {
          item.addEventListener('click', () => {
            menuToggle.setAttribute('aria-expanded', 'false');
            menuToggle.setAttribute('aria-label', 'Open navigation menu');
            sidebar.classList.remove('is-open');
          });
        });
      }
    </script>
  </body>
</html>
