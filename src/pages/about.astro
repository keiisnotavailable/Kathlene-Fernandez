---
import SiteLayout from '../layouts/SiteLayout.astro';
import profile from '../data/profile.json';
---

<SiteLayout title="About" activePage="about" background="/about-bg.jpg">
  <section id="about" class="about-section">
    <div class="section-header">
      <span class="subtitle">01 // about me</span>
      <h2>Learn more about me</h2>
    </div>
    <div class="about-grid">
      <div class="about-details-card">
        <div class="details-table">
          <div class="detail-row">
            <span class="label">Name:</span>
            <span class="value">{profile.displayName}</span>
          </div>
          <div class="detail-row">
            <span class="label">Course:</span>
            <span class="value">{profile.course}</span>
          </div>
          <div class="detail-row">
            <span class="label">Year Level:</span>
            <span class="value">{profile.yearLevel}</span>
          </div>
          <div class="detail-row">
            <span class="label">School:</span>
            <span class="value">{profile.school}</span>
          </div>
        </div>
      </div>
      <div class="about-bio-card">
        <p class="lead">{profile.aboutLead}</p>
        <p>{profile.aboutBio}</p>
      </div>
    </div>

    <div class="favorites-section">
      <span class="fav-title">Interests & Preferences</span>
      <div class="fav-tags">
        {profile.interests.map((interest) => <span class="pill-dark">{interest}</span>)}
      </div>
    </div>
  </section>
</SiteLayout>
