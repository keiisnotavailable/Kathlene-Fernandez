---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About" activePage="about" background="/about-bg.jpg">
  <section id="about" class="about-section">
    <div class="section-header">
      <span class="subtitle">01 // about me</span>
      <h2>Learn more about me</h2>
    </div>
    <div class="about-grid">
      <div class="about-details-card">
        <div class="details-table">
          <div class="detail-row">
            <span class="label">Name:</span>
            <span class="value">Kathlene Fernandez</span>
          </div>
          <div class="detail-row">
            <span class="label">Course:</span>
            <span class="value">BSIT-MWA</span>
          </div>
          <div class="detail-row">
            <span class="label">Year Level:</span>
            <span class="value">4th Year</span>
          </div>
          <div class="detail-row">
            <span class="label">School:</span>
            <span class="value">National University - MOA</span>
          </div>
        </div>
      </div>
      <div class="about-bio-card">
        <p class="lead">
          I am a learning and aspiring full stack developer specializing in web application.
        </p>
        <p>
          I specialize in bridging creative multimedia design and interactive web experiences. My goal is to craft visually 
          engaging user interfaces, brand assets, and digital media backed 
          by clean design systems and intuitive user flows.
        </p>
      </div>
    </div>

    <div class="favorites-section">
      <span class="fav-title">Interests & Preferences</span>
      <div class="fav-tags">
        <span class="pill-dark">Animals</span>
        <span class="pill-dark">Sports</span>
        <span class="pill-dark">Anime</span>
        <span class="pill-dark">Music</span>
        <span class="pill-dark">Minimalism</span>
        <span class="pill-dark">Florals</span>
        <span class="pill-dark">Minimalist</span>
        <span class="pill-dark">Retro</span>
      </div>
    </div>
  </section>
</SiteLayout>
