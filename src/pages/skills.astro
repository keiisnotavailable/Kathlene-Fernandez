---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Skills" activePage="skills" background="/skills-bg.jpg">
  <section id="skills" class="skills-section">
    <div class="section-header">
      <span class="subtitle">03 // technical skills</span>
      <h2>Tools & Core Competencies</h2>
    </div>
    <div class="skills-grid">
      <div class="skill-card">
        <h3>Design & Multimedia</h3>
        <ul class="skill-list">
          <li>Figma (UI/UX & Protoyping)</li>
          <li>Canva</li>
          <li>Adobe Creative Suite</li>
          <li>Video Editing (mainly Capcut) / CSS3</li>
        </ul>
      </div>
      <div class="skill-card">
        <h3>Web & Interactive</h3>
        <ul class="skill-list">
          <li>React / React Native</li>
          <li>HTML5</li>
          <li>CSS3</li>
          <li>Tailwind CSS</li>
        </ul>
      </div>
      <div class="skill-card">
        <h3>Development & Tools</h3>
        <ul class="skill-list">
          <li>Unity 3D (Interactive Assets)</li>
          <li>Git & GitHub</li>
          <li>Firebase</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
