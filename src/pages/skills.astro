---
import SiteLayout from '../layouts/SiteLayout.astro';
import skills from '../data/skills.json';
---

<SiteLayout title="Skills" activePage="skills" background="/skills-bg.jpg">
  <section id="skills" class="skills-section">
    <div class="section-header">
      <span class="subtitle">03 // technical skills</span>
      <h2>Tools & Core Competencies</h2>
    </div>
    <div class="skills-grid">
      {skills.groups.map((group) => (
        <div class="skill-card">
          <h3>{group.title}</h3>
          <ul class="skill-list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="badges-section">
      <span class="subtitle">badges &amp; certifications</span>
      <div class="badges-grid">
        {skills.badges.map((badge) => (
          <a
            class="badge-card"
            href={badge.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${badge.alt}`}
          >
            <img src={badge.image} alt={badge.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
