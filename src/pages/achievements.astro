---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Achievements" activePage="achievements" background="/achievements-bg.jpg">
  <section id="achievements" class="achievements-section">
    <div class="section-header">
      <span class="subtitle">04 // achievements</span>
      <h2>Milestones & Experience</h2>
    </div>

    <div class="achievements-timeline">
      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">leadership</span>
        </div>
        <div class="timeline-content">
          <h4>Lead Programmer — Capstone Project</h4>
          <p>
            Architected end-to-end frontend interfaces for web app, designed high-fidelity interactive wireframes, custom UI components, and design systems in Figma focusing on visual hierarchy and accessibility, integrating AI-driven content generation tools. flows for the pet
            management system "TAILS: An Intelligent Animal Welfare Management System".
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">game design</span>
        </div>
        <div class="timeline-content">
          <h4>Game & Narrative UI Developer</h4>
          <p>
            Developed an immersive first-person utility and horror game in Unity utilizing precise
            proximity and relative trigger mechanics.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">Learning &amp; Certifications</span>
        </div>
        <div class="timeline-content">
          <h4>Basic Cisco Networking</h4>
          <p>
            Completed certification in basic Cisco networking principles and practices. (Yes, I
            actually know what an IP address is now.)
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">Learning &amp; Certifications</span>
        </div>
        <div class="timeline-content">
          <h4>IBM SkillsBuild - AI Powered Racing Course</h4>
          <p>
            Completed learning in AI-powered racing course design and implementation.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">Learning &amp; Certifications</span>
        </div>
        <div class="timeline-content">
          <h4>IBM SkillsBuild - AI Literacy</h4>
          <p>
            Earned certification in core AI concepts, exploring how machine learning models 
            and generative AI tools enhance modern UI design systems and interactive workflows.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">2026</span>
          <span class="timeline-tag">Learning &amp; Certifications</span>
        </div>
        <div class="timeline-content">
          <h4>IBM SkillsBuild - Git Tutorials</h4>
          <p>
            Completed learning in Git version control and collaborative development practices.
            Mostly just learned how to pray before running 'git push'.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">Current</span>
          <span class="timeline-tag">academic</span>
        </div>
        <div class="timeline-content">
          <h4>SM Scholar</h4>
          <p>
            Maintaining strong academic performance standards and technical representation within
            the school and company program.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-year">Current</span>
          <span class="timeline-tag">academic</span>
        </div>
        <div class="timeline-content">
          <h4>Dean's Lister - A.Y 2023-2026</h4>
          <p>
            Recognized for maintaining exceptional academic performance throughout the specified
            academic years.
          </p>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
