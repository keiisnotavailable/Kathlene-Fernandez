---
import SiteLayout from '../layouts/SiteLayout.astro';
import profile from '../data/profile.json';
---

<SiteLayout title="Contact" activePage="contact" background="/contact-bg.jpg">
  <section id="contact" class="contact-section">
    <div class="contact-card">
      <span class="subtitle">get in touch</span>
      <h2>Get in Touch</h2>
      <p>{profile.contactIntro}</p>

      <div class="contact-links">
        <div class="direct-contact">
          <a href={`mailto:${profile.email}`} class="email-btn">
            <i data-lucide="mail"></i> Email Me
          </a>
          <a
            href={profile.resumePath}
            class="resume-btn"
            download="KathleneFernandez_Resume.pdf"
            target="_blank"
            rel="noopener"
          >
            <i data-lucide="download"></i> Download Resume
          </a>
        </div>

        <div class="socials">
          {profile.socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer">
              <i data-lucide={social.label}></i> <span>{social.label}</span>
            </a>
          ))}
        </div>
      </div>
      <a class="contact-phone" href={`tel:${profile.phone.replaceAll(' ', '')}`}>
        <i data-lucide="phone"></i> {profile.phone}
      </a>
    </div>
  </section>
</SiteLayout>

<script is:inline src="https://unpkg.com/lucide@latest"></script>
<script is:inline>
  lucide.createIcons();
</script>
